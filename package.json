{
  "name": "mecha-boosya",
  "version": "1.0.0",
  "description": "Discord bot for Kemwer's server: forum post rankings, birthdays",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/supervisor.js",
    "dev": "node src/index.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=94 --test-coverage-branches=83 --test-coverage-functions=82",
    "lint": "biome lint src",
    "typecheck": "tsc --noEmit",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "drill": "node src/tools/restore-drill.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "discord.js": "^14.21.0",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2"
  }
}
